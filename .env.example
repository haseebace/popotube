# Frontend/public Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-key

# Backend/server Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Real-Debrid
REAL_DEBRID_API_KEY=your-real-debrid-api-key

# TMDb
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3

# Torrentio base URL for the Fastify backend (same var in backend/.env when split).
# TORRENTIO_BASE_URL=https://your-relay.example.com

# Backend base URL (server-side fallbacks, scripts, Docker)
BACKEND_URL=http://127.0.0.1:3001

# Browser-visible Fastify origin (Next client components). Match BACKEND_URL in local dev.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3001

# Comma-separated origins for Fastify @fastify/cors, or * for reflect request origin (dev only).
# Defaults: http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN=https://your-app.example.com

# Jackett
JACKETT_URL=http://127.0.0.1:9117
JACKETT_API_KEY=your-jackett-api-key
