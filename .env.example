# Frontend/public Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-key

# Backend/server Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Real-Debrid
REAL_DEBRID_API_KEY=your-real-debrid-api-key

# TMDb
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3

# Backend base URL used by Next.js server routes
BACKEND_URL=http://127.0.0.1:3001

# Jackett
JACKETT_URL=http://127.0.0.1:9117
JACKETT_API_KEY=your-jackett-api-key

# Mediaflow (optional)
MEDIAFLOW_BASE_URL=
MEDIAFLOW_API_PASSWORD=
MEDIAFLOW_ENABLED=false

# Internal key used by protected backend routes
BACKEND_INTERNAL_API_KEY=your-long-random-key
