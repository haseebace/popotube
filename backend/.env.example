# Backend runtime
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Database / Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Real-Debrid
REAL_DEBRID_API_KEY=your-real-debrid-api-key

# TMDb
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3

# Jackett
# Use Docker service DNS when backend + jackett run in same Compose stack.
# For host-run backend, use http://127.0.0.1:9117 instead.
JACKETT_URL=http://jackett:9117
JACKETT_API_KEY=your-jackett-api-key

# Mediaflow (optional)
MEDIAFLOW_BASE_URL=
MEDIAFLOW_API_PASSWORD=
MEDIAFLOW_ENABLED=false
MEDIAFLOW_ALLOWED_UPSTREAM_HOSTS=

# Internal route auth (use one key name consistently)
BACKEND_INTERNAL_API_KEY=your-long-random-key
