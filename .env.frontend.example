# Vercel / Next.js server runtime
BACKEND_URL=https://api.example.com
# Same API host for browser fetches (required for client-side admin + public TMDB/watch calls)
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3

# Public Supabase keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-key

# Optional frontend feature flags
NEXT_PUBLIC_MOTION_IGNORE_REDUCED=0
